[
  {
    "id": "preferences",
    "children": [
      {
        "id": "package-settings",
        "children": [
          {
            "caption": "minijump",
            "children": [
              {
                "caption": "README",
                "command": "open_file",
                "args": { "file": "${packages}/minijump/README.md" },
              },
              { "caption": "-" },
              {
                "caption": "Settings – Default",
                "command": "open_file",
                "args": {
                  "file": "${packages}/minijump/minijump.sublime-settings",
                },
              },
              {
                "caption": "Settings – User",
                "command": "open_file",
                "args": {
                  "file": "${packages}/User/minijump.sublime-settings",
                },
              },
              { "caption": "-" },
              {
                "caption": "Key Bindings – Default",
                "command": "open_file",
                "args": {
                  "file": "${packages}/minijump/Default (OSX).sublime-keymap",
                },
                "platform": "OSX",
              },
              {
                "caption": "Key Bindings – Default",
                "command": "open_file",
                "args": {
                  "file": "${packages}/minijump/Default (Linux).sublime-keymap",
                },
                "platform": "Linux",
              },
              {
                "caption": "Key Bindings – Default",
                "command": "open_file",
                "args": {
                  "file": "${packages}/minijump/Default (Windows).sublime-keymap",
                },
                "platform": "Windows",
              },
              {
                "caption": "Key Bindings – User",
                "command": "open_file",
                "args": {
                  "file": "${packages}/User/Default (OSX).sublime-keymap",
                },
                "platform": "OSX",
              },
              {
                "caption": "Key Bindings – User",
                "command": "open_file",
                "args": {
                  "file": "${packages}/User/Default (Linux).sublime-keymap",
                },
                "platform": "Linux",
              },
              {
                "caption": "Key Bindings – User",
                "command": "open_file",
                "args": {
                  "file": "${packages}/User/Default (Windows).sublime-keymap",
                },
                "platform": "Windows",
              },
            ],
          },
        ],
      },
    ],
  },
]
