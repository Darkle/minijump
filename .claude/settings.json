{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git rm *)"
    ],
    "allow": [
      "Edit(//tmp/**)",
      "Read(//tmp/**)",
      "Read(//nix/**)",
      "Bash(mise run lint)",
      "Bash(mise run lint:*)",
      "Bash(readlink *)",
      "Bash(rg *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(zcat *)",
      "Bash(printf *)",
      "Bash(strings *)",
      "Bash(man *)",
      "Bash(getent *)",
      "Bash(nix-store -q *)",
      "Bash(systemctl status *)",
      "Bash(systemctl cat *)",
      "Bash(systemctl list-timers *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        ".",
        "~/.local/share/mise/installs/shellcheck",
        "~/.local/state/mise",
        "~/.gitconfig"
      ],
      "allowWrite": [
        ".",
        "/tmp"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com"
      ]
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  }
}