{
  // Characters to use as labels, in order. At most len(labels) targets
  // are labeled per jump; targets beyond that are not shown.
  // Characters must be unique (duplicates are dropped).
  // May also be given as a JSON array of strings.
  "labels": "sadewcvgtbfhijklmnopqruxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",

  // Toggles case sensitive search in word mode.
  "search_case_sensitivity": false,

  // ------------------- Label appearance ---------------------------------

  // Colors. Any CSS color works: named, #rgb, #rrggbb, #rrggbbaa, rgb(),
  // hsl(), ... The defaults match the "invalid" style of the default
  // color schemes (Mariana / Breakers).

  // Label colors. Empty background = the color scheme's accent color;
  // empty foreground = a color contrasting with the background.
  "label_foreground": "#f7f7f7",
  "label_background": "#ec5f67",

  // Highlight drawn on the target characters. Sublime can only color
  // highlights through the color scheme, so minijump writes a small
  // override (one rule for the private "minijump.target" scope) per
  // color scheme in use to Packages/User/minijump/. It is only rewritten
  // when these colors or your color scheme change.
  // Empty background = no highlight (the overrides are emptied, not deleted).
  "target_foreground": "#f7f7f7",
  "target_background": "#ec5f67",

  // Font face and size (points, like Sublime's own font_size) used for
  // labels. Empty/0 = match the view's font. Matching the view font is
  // what makes labels sit exactly on top of the target characters.
  "label_font_face": "",
  "label_font_size": 0,

  "label_bold": true,

  // Box styling around each label.
  "label_padding": 1,
  "label_border_radius": 2,

  // Horizontal pull-back of the label over the target character, in em
  // (relative to the label font size). Monospace advance widths are
  // ~0.5–0.62em; 0.6 is correct for most fonts. Raise it if labels sit
  // too far right, lower it if they sit too far left (e.g. 0.5 for
  // Ubuntu Mono).
  "label_offset_em": 0.6,
}
